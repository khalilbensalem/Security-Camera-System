{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "rm -rf build && cmake -B build -DCMAKE_BUILD_TYPE=Debug && cd build && make",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "rm -rf build && cmake -B build -DCMAKE_BUILD_TYPE=Release && cd build && make",
        }
    ]
}